const SHEET_NAME = 'Orders';
const SPREADSHEET_ID = '1vFyERjcp02kqyxLi4GNxpLftu8WXHXpuy1m_y3wVIrM';
function getOrdersSpreadsheet(){const ss=SPREADSHEET_ID?SpreadsheetApp.openById(SPREADSHEET_ID):SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('No spreadsheet found. Check SPREADSHEET_ID and sharing access.');return ss;}
function json(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);}
function saveOrder(payload){const sheet=getOrdersSpreadsheet().getSheetByName(SHEET_NAME)||getOrdersSpreadsheet().insertSheet(SHEET_NAME),headers=['Received at','Order ID','Name','Phone','Email','Address','City','State','Pincode','Payment method','Payment status','Total (INR)','Items'];if(sheet.getLastRow()===0)sheet.appendRow(headers);const orderId=payload.orderId||'';if(orderId&&sheet.getLastRow()>1&&sheet.getRange(2,2,sheet.getLastRow()-1,1).getValues().flat().includes(orderId))return{ok:true,duplicate:true};const items=Array.isArray(payload.items)?payload.items:[],itemText=items.map(item=>`${item.title} | ${item.model} | ${item.colour} | qty ${item.quantity} | ₹${item.unitPrice}`).join(' ; ');sheet.appendRow([new Date(),orderId,payload.customer?.name||'',payload.customer?.phone||'',payload.customer?.email||'',payload.customer?.address||'',payload.customer?.city||'',payload.customer?.state||'',payload.customer?.pincode||'',payload.paymentMethod||'UPI QR',payload.paymentStatus||'Payment initiated',Number(payload.total||0),itemText]);return{ok:true};}
function doGet(e){try{const raw=e&&e.parameter&&e.parameter.payload;return raw?json(saveOrder(JSON.parse(raw))):json({ok:true,service:'Coverly order capture'});}catch(error){return json({ok:false,error:String(error)});}}
function doPost(e){try{const raw=(e&&e.postData&&e.postData.contents)||(e&&e.parameter&&e.parameter.payload)||'{}';return json(saveOrder(typeof raw==='string'?JSON.parse(raw):raw));}catch(error){return json({ok:false,error:String(error)});}}
